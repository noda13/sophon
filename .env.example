# Prisma
DATABASE_URL="file:./dev.db"

# Data provider: jquants | edinet | csv | composite
DATA_PROVIDER="csv"

# J-Quants V2 API (2025-12-22 以降、新規ユーザーは V2 のみ)
JQUANTS_API_KEY=""

# Server
PORT=8902
# Comma-separated allowed origins for CORS (required in production; empty allows all in development only)
ALLOWED_ORIGINS=""
NODE_ENV=development
TZ=Asia/Tokyo
# Bind address (use 0.0.0.0 inside containers)
HOST=127.0.0.1
# Required to use /api/admin/*; when empty those routes respond 503
ADMIN_TOKEN=""
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Screening defaults
MARKET_CAP_MAX_YEN=50000000000
NET_CASH_RATIO_MIN=0.3
MVP_STOCK_LIMIT=30
